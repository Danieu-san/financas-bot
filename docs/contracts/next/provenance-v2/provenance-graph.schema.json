    "selector": {"type":"object","additionalProperties":false,"required":["kind","segments"],"properties":{"kind":{"enum":["family","person","account","card","category","event","budget","bill","source_state","proposal","reminder","calendar_event","side_effect","merchant_rule","fixture","collection","source_origin","merchant_identity","transfer_identity","installment_plan","turn","derived_claim"]},"segments":{"type":"array","minItems":1,"items":{"type":"string","pattern":"^[a-z][a-z0-9_]*$"}}}},
