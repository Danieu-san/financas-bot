    "arg": {"oneOf":[{"type":"object","additionalProperties":false,"required":["node"],"properties":{"node":{"$ref":"#/definitions/id"}}},{"type":"object","additionalProperties":false,"required":["set"],"properties":{"set":{"$ref":"#/definitions/id"}}},{"type":"object","additionalProperties":false,"required":["field"],"properties":{"field":{"$ref":"#/definitions/fieldPath"}}},{"type":"object","additionalProperties":false,"required":["claim"],"properties":{"claim":{"$ref":"#/definitions/claimPath"}}},{"type":"object","additionalProperties":false,"required":["literal"],"properties":{"literal":{"$ref":"#/definitions/literal"}}},{"type":"object","additionalProperties":false,"required":["selector"],"properties":{"selector":{"$ref":"#/definitions/selector"}}},{"type":"object","additionalProperties":false,"required":["template","bindings"],"properties":{"template":{"$ref":"#/definitions/reference"},"bindings":{"type":"object","minProperties":1,"propertyNames":{"$ref":"#/definitions/id"},"additionalProperties":{"$ref":"#/definitions/arg"}}}},{"type":"object","additionalProperties":false,"required":["partial_policy"],"properties":{"partial_policy":{"$ref":"#/definitions/reference"}}},{"type":"object","additionalProperties":false,"required":["sort"],"properties":{"sort":{"$ref":"#/definitions/sort"}}},{"type":"object","additionalProperties":false,"required":["projection"],"properties":{"projection":{"type":"object","additionalProperties":false,"required":["set","selector","as"],"properties":{"set":{"$ref":"#/definitions/id"},"selector":{"$ref":"#/definitions/selector"},"as":{"enum":["sequence","set"]}}}}}]},
